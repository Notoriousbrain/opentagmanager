{
  "extends": "@otm/typescript-config/base.json",
  "compilerOptions": {
    "jsx": "react",
    "outDir": "dist",
    "rootDir": "src",

    "module": "esnext",
    "target": "es2022",
    "moduleResolution": "bundler",

    "declaration": true,
    "declarationMap": true,

    "isolatedModules": false,
    "noEmit": false,

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
