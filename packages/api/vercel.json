{
  "version": 2,
  "builds": [
    {
      "src": "dist/index.js",
      "use": "@vercel/node",
      "config": { "includeFiles": ["../../packages/**"] }
    },
    { "src": "dist/health.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/health", "dest": "dist/health.js" },
    { "src": "/api/trpc(?:/.*)?", "dest": "dist/index.js" }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
