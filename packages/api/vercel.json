{
  "version": 2,
  "builds": [
    {
      "src": "src/index.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["../../packages/**"]
      }
    },
    {
      "src": "src/health.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/trpc(?:/.*)?", "dest": "src/index.ts" },
    { "src": "/health", "dest": "src/health.ts" }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
