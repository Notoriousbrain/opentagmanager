{
  "name": "opentagmanager",
  "version": "0.1.0",
  "devDependencies": {
    "@biomejs/biome": "^2.2.5",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "eslint": "^9.37.0",
    "eslint-config-next": "^15.5.4",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "turbo": "^2.5.8",
    "typescript": "5.9.3"
  },
  "engines": {
    "bun": ">=1.2.19"
  },
  "license": "MIT",
  "packageManager": "bun@1.2.19",
  "private": true,
  "scripts": {
    "dev": "bun --env-file=.env turbo run dev",
    "build": "bun --env-file=.env turbo run build",
    "start": "bun --env-file=.env turbo run start",
    "lint": "biome lint .",
    "format": "biome format .",
    "lint:web": "eslint apps --max-warnings=0",
    "check:types": "tsc -b --noEmit || tsc --noEmit",
    "check-types": "turbo run check-types",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:clean": "docker compose down -v",
    "docker:logs": "docker compose logs -f",
    "docker:ps": "docker compose ps",
    "docker:restart": "docker compose restart",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:push": "turbo run db:push",
    "db:studio": "turbo run db:studio",
    "docs": "turbo dev --filter=docs",
    "dashboard": "turbo dev --filter=dashboard",
    "upgrade": "bun scripts/bump-catalog.ts --prefix=exact --tag=latest --and-update --yes",
    "upgrade:caret": "bun scripts/bump-catalog.ts --prefix=caret --tag=latest --and-update --yes",
    "upgrade:dry": "bun scripts/bump-catalog.ts --prefix=exact --tag=latest --dry-run",
    "promote:user": "bun packages/db/scripts/promote-user.ts"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@trpc/client": "^11.6.0",
      "@trpc/server": "^11.6.0",
      "@trpc/react-query": "^11.6.0",
      "@trpc/tanstack-react-query": "^11.6.0",
      "@tanstack/react-query": "^5.90.2",
      "eslint-config-next": "^15.5.4",
      "superjson": "^2.2.2",
      "better-auth": "^1.3.26",
      "drizzle-orm": "^0.44.6",
      "drizzle-zod": "^0.8.3",
      "next": "^15.5.4",
      "react": "^19.2.0",
      "react-dom": "^19.2.0",
      "react-hook-form": "^7.63.0",
      "lucide-react": "^0.544.0",
      "sonner": "^2.0.7",
      "server-only": "^0.0.1",
      "zod": "^4.1.11",
      "typescript": "^5.9.3",
      "eslint": "^9.37.0",
      "@types/node": "^24.6.2",
      "@types/react": "^19.2.0",
      "@types/react-dom": "^19.2.0",
      "@tailwindcss/postcss": "^4.1.14",
      "tailwindcss": "^4.1.14"
    }
  }
}
