OTM_DATABASE_URL=postgresql://otm:omguseotm@localhost:5432/otm
OTM_PROJECT_URL=localhost:3000

OTM_UPSTASH_REDIS_REST_URL=your-upstash-redis-rest-url
OTM_UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-rest-toke 

VERCEL_ENV=development
NEXT_PUBLIC_VERCEL_ENV=development

NEXT_PUBLIC_OTM_RELAY_URL=http://localhost:8787/collect
NEXT_PUBLIC_OTM_PREVIEW_FLAG=otm_preview

BETTER_AUTH_SECRET=superlongrandomsecretstringofatleast32chars

GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

GITHUB_TOKEN=ghp_********************************
OSSTAG_MARKETING_LOCK=0

KAFKA_BROKERS=broker-1.amazonaws.com:9096,broker-2.amazonaws.com:9096
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=scram-sha-512
KAFKA_SASL_USERNAME=__from_secrets_manager__
KAFKA_SASL_PASSWORD=__from_secrets_manager__
KAFKA_TOPIC_INGEST=osstag.ingest

S3_REGION=ap-south-1
S3_BUCKET=osstag-raw
S3_ACCESS_KEY_ID=AKIA...
S3_SECRET_ACCESS_KEY=...
# S3_ENDPOINT=  # leave empty for AWS

RELAY_MAX_BODY_KB=64
RELAY_MAX_EVENTS=50
RELAY_SKEW_MS=300000
RELAY_RPS_PER_KEY_IP=120

OTM_API_KEY_PEPPER=please-change-me-to-a-long-random-string
 
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=osstag
